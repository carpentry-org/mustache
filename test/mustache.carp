(load "main.carp")
(load "Test.carp")

(use-all Mustache Test)

(def *calls* 0)

(sig count-call (Fn [String] String))
(defn count-call [_] (do (set! *calls* (Int.inc *calls*)) (str *calls*)))

(sig emit-own-section (Fn [String] String))
(defn emit-own-section [body] (fmt "s{{#x}}%s{{/x}}" &body))

(sig emit-own-tag (Fn [String] String))
(defn emit-own-tag [_] @"i{{x}}")

(sig nest-sections (Fn [Int] String))
(defn nest-sections [n]
  (let-do [sb (StringBuf.create)]
    (for [i 0 n] (StringBuf.append-str &sb "{{#a}}"))
    (StringBuf.append-str &sb "deep")
    (for [i 0 n] (StringBuf.append-str &sb "{{/a}}"))
    (StringBuf.to-string &sb)))

(deftest test
  (assert-equal test
    "this is a strawberry"
    &(template "this is a {{ thing }}" &{@"thing" (Mustache.Str @"strawberry")})
    "simple templating works")
  (assert-equal test
    "this is a &lt;strawberry&gt;"
    &(template "this is a {{ thing }}"
               &{@"thing" (Mustache.Str @"<strawberry>")})
    "simple templating & escaping works")
  (assert-equal test
    "&amp; &lt; &gt; &quot; &#39;"
    &(template "{{ x }}" &{@"x" (Mustache.Str @"& < > \" '")})
    "escapes all five HTML-significant characters")
  (assert-equal test
    "this is a <strawberry>"
    &(template "this is a {{{ thing }}}"
               &{@"thing" (Mustache.Str @"<strawberry>")})
    "simple templating without escaping works")
  (assert-equal test
    "this is a "
    &(template "this is a {{{ thing }}}" &{})
    "simple templating with missing values works")
  (assert-equal test
    "this is a strawberry"
    &(template "this is a {{{ thing }}}"
               &{@"thing" (Mustache.Lambda (fn [_] @"strawberry"))})
    "simple templating with functions works")
  (assert-equal test "partial says: 'hi, mustache!
'" &(template "partial says: '{{> test/file }}'"
              &{@"name" (Mustache.Str @"mustache")}) "simple templating with partials works")
  (assert-equal test
    "this is an explosion!"
    &(template
      "this is an explosion{{# thing }}!{{/ thing }}"
      &{@"thing" (Mustache.Str @"!")})
    "simple sections with strings works")
  (assert-equal test
    "this is an "
    &(template
      "this is an {{# thing }}explosion!{{/ thing }}"
      &{@"thing" (Mustache.Str @"")})
    "simple sections with empty strings works")
  (assert-equal test
    "this is an explosion!"
    &(template
      "this is an {{# thing }}explosion{{/ thing }}"
      &{@"thing" (Mustache.Lambda (fn [x] (String.append &x "!")))})
    "simple sections with functions works")
  (assert-equal test
    "value"
    &(template "{{#wrap}}{{x}}{{/wrap}}"
               &{@"wrap" (Mustache.Lambda (fn [s] s))
                 @"x" (Mustache.Str @"value")})
    "section lambda output is re-parsed and interpolated, not passed through")
  (assert-equal test
    "hi"
    &(template "{{#wrap}}{{#b}}hi{{/b}}{{/wrap}}"
               &{@"wrap" (Mustache.Lambda (fn [s] s))
                 @"b" (Mustache.Str @"truthy")})
    "section lambda output containing a section renders against the context")
  (assert-equal test
    "value"
    &(template "{{=[ ]=}}[#wrap][x][/wrap]"
               &{@"wrap" (Mustache.Lambda (fn [s] s))
                 @"x" (Mustache.Str @"value")})
    "section lambda output re-parses with the delimiters active at the section")
  (assert-equal test
    "Hello, world!"
    &(template "Hello, {{lambda}}!"
               &{@"lambda" (Mustache.Lambda (fn [_] @"world"))})
    "an interpolated lambda's return value is used")
  (assert-equal test
    "Hello, world!"
    &(template "Hello, {{lambda}}!"
               &{@"planet" (Mustache.Str @"world")
                 @"lambda" (Mustache.Lambda (fn [_] @"{{planet}}"))})
    "interpolated lambda output is parsed and rendered against the context")
  (assert-equal test "Hello, (|planet| => world)!" &(template "{{= | | =}}
Hello, (|&lambda|)!" &{@"planet" (Mustache.Str @"world")
                       @"lambda" (Mustache.Lambda (fn [_]
                                                    @"|planet| => {{planet}}"))}) "interpolated lambda output parses with the default delimiters")
  (assert-equal test
    "1 == 2 == 3"
    &(template
      "{{lambda}} == {{{lambda}}} == {{lambda}}"
      &{@"lambda" (Mustache.Lambda count-call)})
    "an interpolated lambda is called once per occurrence")
  (assert-equal test
    "<&gt;>"
    &(template "<{{lambda}}{{{lambda}}}"
               &{@"lambda" (Mustache.Lambda (fn [_] @">"))})
    "an interpolated lambda's rendered output is escaped, a raw tag's is not")
  (assert-equal test
    "deep"
    &(template "{{a.b}}"
               &{@"a" (Mustache.Mp
                   {@"b" (Box.init (Mustache.Lambda (fn [_] @"deep")))})})
    "a lambda reached through a dotted name is called")
  (assert-equal test
    "[]"
    &(template "[{{lambda}}]" &{@"lambda" (Mustache.Lambda (fn [_] @""))})
    "a lambda returning the empty string renders as empty")
  (assert-equal test
    "[]"
    &(template "[{{lambda}}]"
               &{@"lambda" (Mustache.Lambda (fn [_] @"{{nope}}"))})
    "a lambda returning unresolvable tags renders as empty")
  (assert-equal test
    "this is an "
    &(template
      "this is an {{{^ thing }}}inverted section{{/ thing }}"
      &{@"thing" (Mustache.Lambda (fn [x] x))})
    "simple inverted sections work I")
  (assert-equal test
    "this is an "
    &(template
      "this is an {{^ thing }}inverted section{{/ thing }}"
      &{@"thing" (Mustache.Str @"there")})
    "simple inverted sections work II")
  (assert-equal test
    "this is an inverted section"
    &(template "this is an {{^ thing }}inverted section{{/ thing }}" &{})
    "simple inverted sections work III")
  (assert-equal test
    "this is an inverted section"
    &(template
      "this is an {{^ thing }}inverted section{{/ thing }}"
      &{@"thing" (Mustache.Str @"")})
    "simple inverted sections work IV")
  (assert-equal test
    "this is an inverted section  with extras!"
    &(template
      "{{prelude}} {{^ thing }}inverted section{{/ thing }} {{#notthere}} i will vanish{{/notthere}} {{# extra }}with extras{{/ extra }}{{# bang }}!{{# band}}"
      &{@"thing" (Mustache.Str @"")
        @"extra" (Mustache.Str @"There")
        @"prelude" (Mustache.Str @"this is an")
        @"bang" (Mustache.Lambda id)})
    "complicated sections work")
  (assert-equal test
    "with switched tags!"
    &(template
      "{{=& &=}}&switched& tags&^inverted&!&/inverted&"
      &{@"switched" (Mustache.Str @"with switched")})
    "switching tags works")
  (assert-equal test
    "a b c "
    &(template "{{#items}}{{.}} {{/items}}"
               &{@"items" (Mustache.Lst
                   [(Box.init (Mustache.Str @"a"))
                    (Box.init (Mustache.Str @"b"))
                    (Box.init (Mustache.Str @"c"))])})
    "list iteration with dot")
  (assert-equal test
    "(empty)"
    &(template
      "{{#items}}x{{/items}}{{^items}}(empty){{/items}}"
      &{@"items" (Mustache.Lst [])})
    "empty list is falsy")
  (assert-equal test
    "Ada Grace "
    &(template "{{#users}}{{name}} {{/users}}"
               &{@"users" (Mustache.Lst
                   [(Box.init
                      (Mustache.Mp {@"name" (Box.init (Mustache.Str @"Ada"))}))
                    (Box.init
                      (Mustache.Mp {@"name" (Box.init (Mustache.Str @"Grace"))}))])})
    "list of object contexts")
  (assert-equal test
    "Carp is typed"
    &(template "{{#lang}}{{name}} is {{kind}}{{/lang}}"
               &{@"lang" (Mustache.Mp
                   {@"name" (Box.init (Mustache.Str @"Carp"))
                    @"kind" (Box.init (Mustache.Str @"typed"))})})
    "map as section context")
  (assert-equal test
    "outer-value"
    &(template "{{#inner}}{{outer}}{{/inner}}"
               &{@"outer" (Mustache.Str @"outer-value")
                 @"inner" (Mustache.Mp {})})
    "inner map falls through to outer context")
  (assert-equal test
    "x=12 y=34 "
    &(template
      "{{#outer}}{{name}}={{#nums}}{{.}}{{/nums}} {{/outer}}"
      &{@"outer" (Mustache.Lst
          [(Box.init
             (Mustache.Mp
               {@"name" (Box.init (Mustache.Str @"x"))
                @"nums" (Box.init
                  (Mustache.Lst
                    [(Box.init (Mustache.Str @"1"))
                     (Box.init (Mustache.Str @"2"))]))}))
           (Box.init
             (Mustache.Mp
               {@"name" (Box.init (Mustache.Str @"y"))
                @"nums" (Box.init
                  (Mustache.Lst
                    [(Box.init (Mustache.Str @"3"))
                     (Box.init (Mustache.Str @"4"))]))}))])})
    "nested list-in-map-in-list")
  (assert-equal test
    "[inherited]"
    &(template "{{#wrap}}[{{prelude}}]{{/wrap}}"
               &{@"wrap" (Mustache.Mp {})
                 @"prelude" (Mustache.Str @"inherited")})
    "outer context inherited through map section")
  (assert-equal test
    "hello world"
    &(template "hello {{! this is a comment }}world" &{})
    "comments are stripped")
  (assert-equal test
    "<strawberry>"
    &(template "{{& thing }}" &{@"thing" (Mustache.Str @"<strawberry>")})
    "explicit raw var with ampersand syntax")
  (assert-equal test
    "[]"
    &(template "[{{> no_such_file }}]" &{})
    "missing partial renders as empty")
  (assert-equal test
    "xy"
    &(template "{{#foo}}x{{/bar}}y{{/foo}}" &{@"foo" (Mustache.Str @"present")})
    "mismatched close tag inside section is ignored")
  (assert-equal test "" &(template "" &{}) "empty template renders as empty")
  (assert-equal test
    ""
    &(template "{{missing}}" &{})
    "missing var renders as empty")
  (assert-equal test
    "hi"
    &(template "{{=foo=}}hi" &{})
    "malformed set-delimiter is consumed without crashing")
  (assert-equal test
    "ab"
    &(template "{{#fs}}{{.}}{{/fs}}"
               &{@"fs" (Mustache.Lst
                   [(Box.init (Mustache.Lambda (fn [_] @"a")))
                    (Box.init (Mustache.Lambda (fn [_] @"b")))])})
    "a lambda reached through the implicit iterator is called")
  ; standalone tag whitespace handling
  (assert-equal test "Begin
End
" &(template "Begin
  {{! standalone comment }}
End
" &{}) "standalone comment strips entire line")
  (assert-equal test
    "hello world"
    &(template "hello {{! inline comment }}world" &{})
    "inline comment preserves surrounding text")
  (assert-equal test "|
|" &(template "|
{{# bool }}
{{/ bool }}
|" &{@"bool" (Mustache.Str @"true")}) "standalone section open and close strip their lines")
  (assert-equal test "|
Content
|" &(template "|
{{# bool }}
Content
{{/ bool }}
|" &{@"bool" (Mustache.Str @"true")}) "standalone section preserves body content")
  (assert-equal test "|
=" &(template "|
{{= | | =}}
|content|" &{@"content" (Mustache.Str @"=")}) "standalone set-delimiter strips its line")
  (assert-equal test "" &(template "  {{! comment }}
" &{}) "standalone comment at start strips line including newline")
  (assert-equal test "!
" &(template "!
  {{! comment }}" &{}) "standalone comment at end strips line without trailing newline")
  (assert-equal test "|
-1-
-2-
|" &(template "|
{{# items }}
-{{.}}-
{{/ items }}
|" &{@"items" (Mustache.Lst
       [(Box.init (Mustache.Str @"1")) (Box.init (Mustache.Str @"2"))])}) "standalone section with list iteration")
  (assert-equal test "|
^
|" &(template "|
{{^ bool }}
^
{{/ bool }}
|" &{@"bool" (Mustache.Str @"")}) "standalone inverted section strips its lines")
  (assert-equal test "Begin


End
" &(template "Begin

{{! comment }}

End
" &{}) "standalone comment with surrounding blank lines preserves blanks")
  ; partial indentation
  (assert-equal test "Begin
  hi, world!
End
" &(template "Begin
  {{> test/file }}
End
" &{@"name" (Mustache.Str @"world")}) "standalone partial is indented to the column of its tag")
  (assert-equal test "X
  a

  b
Y
" &(template "X
  {{> test/blank-line }}
Y
" &{}) "empty lines in an indented partial are not given the indent")
  (assert-equal test "\\
 |
 <
->
 |
/
" &(template "\\
 {{> test/indent }}
/
" &{@"content" (Mustache.Str @"<
->")}) "each line of the partial source is indented, interpolated values are not")
  (assert-equal test "  |  >
>
" &(template "  {{data}}  {{> test/inline }}
" &{@"data" (Mustache.Str @"|")}) "inline partial is not indented")
  (assert-equal test
    "| \t|\t |"
    &(template "| {{> test/tabs }} |" &{})
    "inline partial keeps the whitespace surrounding its tag")
  (assert-equal test "  >
  >@>" &(template "  {{> test/arrow }}
>" &{}) "standalone partial without a previous line is indented")
  (assert-equal test ">
  >
  >@" &(template ">
  {{> test/arrow }}" &{}) "standalone partial without a trailing newline is indented")
  (assert-equal test "start
  |
    a
    b
  |
end
" &(template "start
  {{> test/nested-outer }}
end
" &{}) "nested standalone partials accumulate indentation")
  (assert-equal test
    "X<Y<>>"
    &(template "{{> test/node }}"
               &{@"content" (Mustache.Str @"X")
                 @"nodes" (Mustache.Lst
                   [(Box.init
                      (Mustache.Mp
                        {@"content" (Box.init (Mustache.Str @"Y"))
                         @"nodes" (Box.init (Mustache.Lst []))}))])})
    "recursive partials terminate and are not indented")
  (assert-equal test "  hi, world!
" &(template "{{# bool }}
  {{> test/file }}
{{/ bool }}
" &{@"bool" (Mustache.Str @"true")
    @"name" (Mustache.Str @"world")}) "standalone partial inside a section is indented")
  (assert-equal test "hi, world!
" &(template "{{=[ ]=}}[> test/file ]" &{@"name" (Mustache.Str @"world")}) "partial after a delimiter change is inline and keeps the default delimiters")
  ; dotted-name resolution
  (assert-equal test
    "Ada"
    &(template "{{user.name}}"
               &{@"user" (Mustache.Mp {@"name" (Box.init (Mustache.Str @"Ada"))})})
    "dotted interpolation resolves a nested map value")
  (assert-equal test
    "deep"
    &(template "{{a.b.c}}"
               &{@"a" (Mustache.Mp
                   {@"b" (Box.init
                      (Mustache.Mp {@"c" (Box.init (Mustache.Str @"deep"))}))})})
    "dotted interpolation resolves arbitrary depth")
  (assert-equal test
    "&lt;x&gt;"
    &(template "{{a.b}}"
               &{@"a" (Mustache.Mp {@"b" (Box.init (Mustache.Str @"<x>"))})})
    "dotted interpolation escapes like a plain var")
  (assert-equal test
    "<x>"
    &(template "{{{a.b}}}"
               &{@"a" (Mustache.Mp {@"b" (Box.init (Mustache.Str @"<x>"))})})
    "dotted interpolation is not escaped in triple-mustache")
  (assert-equal test
    "Carp is typed"
    &(template "{{#a.b}}{{name}} is {{kind}}{{/a.b}}"
               &{@"a" (Mustache.Mp
                   {@"b" (Box.init
                      (Mustache.Mp
                        {@"name" (Box.init (Mustache.Str @"Carp"))
                         @"kind" (Box.init (Mustache.Str @"typed"))}))})})
    "dotted section pushes the nested map as a context frame")
  (assert-equal test
    "1 2 "
    &(template "{{#a.nums}}{{.}} {{/a.nums}}"
               &{@"a" (Mustache.Mp
                   {@"nums" (Box.init
                      (Mustache.Lst
                        [(Box.init (Mustache.Str @"1"))
                         (Box.init (Mustache.Str @"2"))]))})})
    "dotted section resolving to a list iterates")
  (assert-equal test
    "x"
    &(template "x{{a.missing.deep}}"
               &{@"a" (Mustache.Mp {@"name" (Box.init (Mustache.Str @"Ada"))})})
    "dotted name through a missing intermediate renders empty")
  (assert-equal test
    "x"
    &(template "x{{#a.missing}}body{{/a.missing}}"
               &{@"a" (Mustache.Mp {@"name" (Box.init (Mustache.Str @"Ada"))})})
    "dotted section with a missing key is skipped")
  (assert-equal test
    "no b"
    &(template "{{^a.b}}no b{{/a.b}}"
               &{@"a" (Mustache.Mp {@"name" (Box.init (Mustache.Str @"Ada"))})})
    "inverted dotted section renders when the name is missing")
  (assert-equal test
    ""
    &(template "{{a.b}}" &{@"a" (Mustache.Str @"plain")})
    "dotted name into a non-map value renders empty")
  (assert-equal test
    ""
    &(template "{{#a}}{{b.c}}{{/a}}"
               &{@"a" (Mustache.Mp
                   {@"b" (Box.init
                      (Mustache.Mp (the (Map String (Box Mustache)) {})))})
                 @"b" (Mustache.Mp {@"c" (Box.init (Mustache.Str @"ERROR"))})})
    "context precedence: dotted head fixes to the section frame b (empty), not top-level b.c")
  (assert-equal test
    ""
    &(template "{{a.b}}" &{@"a.b" (Mustache.Str @"ERROR")})
    "a literal a.b map key is never matched by dotted {{a.b}} (name is split first)")
  (assert-equal test
    &(String.repeat 4000 "a&amp;b&lt;c&gt;d&quot;e&#39;f")
    &(template "{{ x }}"
               &{@"x" (Mustache.Str (String.repeat 4000 "a&b<c>d\"e'f"))})
    "escapes a large mixed input without quadratic blowup")
  ; inheritance: block and parent tags
  (assert-equal test "Default title
" &(template "{{$title}}Default title{{/title}}
" &{}) "a block outside a parent renders its default")
  (assert-equal test "default baz content
" &(template "{{$foo}}default {{bar}} content{{/foo}}
" &{@"bar" (Mustache.Str @"baz")}) "default block content interpolates variables")
  (assert-equal test "default <baz> content
" &(template "{{$foo}}default {{{bar}}} content{{/foo}}
" &{@"bar" (Mustache.Str @"<baz>")}) "default block content interpolates triple mustaches")
  (assert-equal test "default qux content
" &(template "{{$foo}}default {{#bar}}{{baz}}{{/bar}} content{{/foo}}
" &{@"bar" (Mustache.Mp {@"baz" (Box.init (Mustache.Str @"qux"))})}) "default block content renders sections")
  (assert-equal test "default three content
" &(template "{{$foo}}default {{^bar}}{{baz}}{{/bar}} content{{/foo}}
" &{@"baz" (Mustache.Str @"three")}) "default block content renders inverted sections")
  (assert-equal test "default {{qux}} content
" &(template "{{$foo}}default {{#bar}}{{baz}}{{/bar}} content{{/foo}}
" &{@"bar" (Mustache.Mp {@"baz" (Box.init (Mustache.Str @"{{qux}}"))})}) "a value interpolated in default block content is not re-parsed")
  (assert-equal test
    "default content"
    &(template "{{<test/inh-include}}{{/test/inh-include}}
" &{})
    "an unparameterised parent renders the blocks of the injected template")
  (assert-equal test
    "...sub template title..."
    &(template
      "{{<test/inh-super}}{{$title}}sub template title{{/title}}{{/test/inh-super}}"
      &{})
    "a block inside a parent overrides the parent's default")
  (assert-equal test
    "var in template"
    &(template
      "{{<test/inh-var}}{{$var}}var in template{{/var}}{{/test/inh-var}}"
      &{@"var" (Mustache.Str @"var in data")})
    "the context does not override an argument passed into a parent")
  (assert-equal test
    "var in include"
    &(template "{{<test/inh-var}}{{/test/inh-var}}"
               &{@"var" (Mustache.Str @"var in data")})
    "the context does not override a block default")
  (assert-equal test
    "test override"
    &(template
      "test {{<test/inh-parent}}{{$stuff}}override{{/stuff}}{{/test/inh-parent}}"
      &{})
    "an inline parent renders in place")
  (assert-equal test "test |override1 default| |override2 default|
" &(template
      "test {{<test/inh-two-parents}}{{$stuff}}override1{{/stuff}}{{/test/inh-two-parents}} {{<test/inh-two-parents}}{{$stuff}}override2{{/stuff}}{{/test/inh-two-parents}}
"
      &{}) "two parents of the same template take different overrides")
  (assert-equal test "peaked

:(
" &(template "{{<test/inh-ballmer}}{{$ballmer}}
peaked

:(
{{/ballmer}}{{/test/inh-ballmer}}" &{}) "an override whose open tag ends its line drops that newline")
  (assert-equal test "stop:
  hammer time
" &(template
      "{{<test/inh-nineties}}{{$nineties}}hammer time{{/nineties}}{{/test/inh-nineties}}"
      &{}) "an override inherits the indentation of the block it replaces")
  (assert-equal test
    "new default one, override two"
    &(template
      "{{<test/inh-two-params}}{{$stuff2}}override two{{/stuff2}}{{/test/inh-two-params}}"
      &{})
    "blocks left unoverridden keep their defaults")
  (assert-equal test
    "default content|default content"
    &(template
      "{{>test/inh-include}}|{{<test/inh-include}}{{/test/inh-include}}"
      &{})
    "a parent with no arguments behaves like a partial")
  (assert-equal test
    "override override override don't recurse"
    &(template "{{<test/inh-rec}}{{$foo}}override{{/foo}}{{/test/inh-rec}}" &{})
    "mutually recursive parents terminate on an override")
  (assert-equal test
    "c"
    &(template "{{<test/inh-ml-parent}}{{$a}}c{{/a}}{{/test/inh-ml-parent}}" &{})
    "the outermost override wins in multi-level inheritance")
  (assert-equal test
    "p"
    &(template "{{<test/inh-ml-parent}}{{/test/inh-ml-parent}}" &{})
    "multi-level inheritance falls back to the nearest override")
  (assert-equal test
    "hmm"
    &(template
      "{{<test/inh-include}} asdfasd {{$foo}}hmm{{/foo}} asdfasdfasdf {{/test/inh-include}}"
      &{})
    "text around blocks inside a parent is ignored")
  (assert-equal test
    "default content"
    &(template
      "{{<test/inh-include}} asdfasd asdfasdfasdf {{/test/inh-include}}"
      &{})
    "a parent holding only text passes no arguments")
  (assert-equal test
    "I say bananas."
    &(template
      "{{<test/inh-scope}}{{$block}}I say {{fruit}}.{{/block}}{{/test/inh-scope}}"
      &{@"fruit" (Mustache.Str @"apples")
        @"nested" (Mustache.Mp {@"fruit" (Box.init (Mustache.Str @"bananas"))})})
    "an override renders against the context at the block it replaces")
  (assert-equal test "Hi,
  one
  two
" &(template "Hi,
  {{<test/inh-lines}}{{/test/inh-lines}}
" &{}) "a parent whose tags share one line is standalone and indented")
  (assert-equal test "Hi,
  one
  two
" &(template "{{<test/inh-sa-block}}{{$block}}
one
two{{/block}}
{{/test/inh-sa-block}}
" &{}) "a block whose tags share one line is standalone and indented")
  (assert-equal test "Hi,
  one
  two
" &(template "{{<test/inh-reindent}}{{$block}}
    one
    two
{{/block}}{{/test/inh-reindent}}
" &{}) "an override is dedented where it is written and indented where it expands")
  (assert-equal test "Hi,
  one
  two
" &(template "{{<test/inh-intrinsic}}{{$block}}
one
two
{{/block}}{{/test/inh-intrinsic}}
" &{}) "a standalone block takes its indentation from its default content")
  (assert-equal test "one
  three
" &(template "{{<test/inh-nested}}{{$nested}}
three
{{/nested}}{{/test/inh-nested}}
" &{}) "a nested block is reindented relative to the block around it")
  (assert-equal test
    "[]"
    &(template "[{{<no_such_parent}}{{$x}}y{{/x}}{{/no_such_parent}}]" &{})
    "a parent naming a missing file renders as empty")
  (assert-equal test
    "P:over"
    &(template "{{<test/inh-thru}}{{$b}}over{{/b}}{{/test/inh-thru}}" &{})
    "overrides stay in scope for partials the parent pulls in")
  ; recursion depth limit
  (assert-equal test
    127
    (String.length &(template "{{>test/rec-self}}" &{}))
    "a self-referencing partial stops at the depth limit")
  (assert-equal test
    127
    (String.length &(template "{{>test/rec-a}}" &{}))
    "mutually recursive partials stop at the depth limit")
  (assert-equal test
    127
    (String.length &(template "{{<test/rec-pself}}{{/test/rec-pself}}" &{}))
    "a self-referencing parent stops at the depth limit")
  (assert-equal test
    127
    (String.length
      &(template "{{#x}}b{{/x}}" &{@"x" (Mustache.Lambda emit-own-section)}))
    "a section lambda re-emitting its own section stops at the depth limit")
  (assert-equal test
    127
    (String.length &(template "{{x}}" &{@"x" (Mustache.Lambda emit-own-tag)}))
    "an interpolation lambda re-emitting its own tag stops at the depth limit")
  (assert-equal test
    "deep"
    &(template &(nest-sections 100) &{@"a" (Mustache.Str @"y")})
    "nesting below the depth limit still renders in full"))
